-- ============================================================
-- DIM_DEVICE.hdbtable
-- DEVICE_ID // SITE_ID / DEVICE_NAME / DEVICE_TYPE  STATUS
--  required — every device must be identifiable and located.
-- ============================================================
COLUMN TABLE "DIM_DEVICE" (
  "DEVICE_ID" NVARCHAR(32) NOT NULL,
  "SITE_ID" NVARCHAR(32) NOT NULL,
  "DEVICE_NAME" NVARCHAR(100) NOT NULL,
  "DEVICE_TYPE" NVARCHAR(50) NOT NULL,  
  PRIMARY KEY ("DEVICE_ID")
);