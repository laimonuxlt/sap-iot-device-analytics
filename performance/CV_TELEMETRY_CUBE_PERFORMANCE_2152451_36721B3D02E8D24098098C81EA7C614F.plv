<?Version 38?>
<Plan ID="ID_2152451_36721B3D02E8D24098098C81EA7C614F_0" xmlns="http://www.sap.com/ndb/planviz" Type="Executed" PlanType="QoExec">
<SQL><![CDATA[SELECT 
	"SITE_NAME",
	"DEVICE_ID",
	"METRIC_NAME",
	AVG(AVG_METRIC_VALUE) AS "AVG_VALUE",
	"UNIT_OF_MEASURE"
FROM "CV_TELEMETRY_CUBE"
GROUP BY 
	"SITE_NAME",
	"DEVICE_ID",
	"METRIC_NAME",
	"UNIT_OF_MEASURE"
ORDER BY "SITE_NAME" ASC]]></SQL>
