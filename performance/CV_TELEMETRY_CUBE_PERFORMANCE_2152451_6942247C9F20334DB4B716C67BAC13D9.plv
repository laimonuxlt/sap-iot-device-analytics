<?Version 38?>
<Plan ID="ID_2152451_6942247C9F20334DB4B716C67BAC13D9_0" xmlns="http://www.sap.com/ndb/planviz" Type="Executed" PlanType="QoExec">
<SQL><![CDATA[SELECT 
	"SITE_NAME",
	"YEAR",
	"MONTH",
	"METRIC_NAME",
	"UNIT_OF_MEASURE",
	AVG("AVG_METRIC_VALUE") AS "AVG_VALUE",
	MIN("MIN_METRIC_VALUE") AS MIN_VALUE,
	MAX("MAX_METRIC_VALUE") AS MAX_VALUE
FROM "CV_TELEMETRY_CUBE"
WHERE "YEAR" = 2026
	AND "MONTH" = 10
GROUP BY 
	"SITE_NAME",
	"YEAR",
	"MONTH",
	"METRIC_NAME",
	"UNIT_OF_MEASURE"]]></SQL>
