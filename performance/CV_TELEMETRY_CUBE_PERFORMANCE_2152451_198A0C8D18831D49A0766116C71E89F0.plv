<?Version 38?>
<Plan ID="ID_2152451_198A0C8D18831D49A0766116C71E89F0_0" xmlns="http://www.sap.com/ndb/planviz" Type="Executed" PlanType="QoExec">
<SQL><![CDATA[SELECT 
	"SITE_NAME",
	"METRIC_NAME",
	"UNIT_OF_MEASURE",
	"HOUR",
	AVG("AVG_METRIC_VALUE") AS "HOURLY_AVG_VALUE"
FROM "CV_TELEMETRY_CUBE"
WHERE "CALENDAR_DATE" = '2026-09-10'
GROUP BY 
	"SITE_NAME",
	"METRIC_NAME",
	"UNIT_OF_MEASURE",
	"HOUR"
ORDER BY 
	"SITE_NAME" ASC, 
	"METRIC_NAME" ASC, 
	"HOUR" ASC]]></SQL>
